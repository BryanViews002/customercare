# Local dev needs none of this: with no POSTGRES_URL the app runs an in-process
# Postgres (PGlite) under data/pgdata. Set ADMIN_* to create your agent login.
ADMIN_EMAIL=you@example.com
ADMIN_NAME=Support Team
ADMIN_PASSWORD=pick-a-strong-one

# Production (Vercel): connection string from Neon. Use the pooled URL.
# POSTGRES_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

PORT=3000
